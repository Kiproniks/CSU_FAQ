TELEGRAM_BOT_TOKEN=

# LLM options: echo | ollama | openai
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT_SEC=120
OPENAI_API_KEY=

# Retrieval settings
CHROMA_PATH=./chroma_db
CHUNK_COLLECTION=harry_potter_collection
CHUNK_SIZE=420
CHUNK_OVERLAP=70
TOP_K_CHUNKS=3
TOP_K_ENTITIES=5
CHUNK_SPLITTER_MODE=smart
CHUNK_MMR_LAMBDA=0.72
ENTITY_CHUNK_SIZE=1100
ENTITY_CHUNK_OVERLAP=200
ENTITY_MIN_LENGTH=5
ENTITY_MAX_ENTITIES_PER_CHUNK=26
ENTITY_TFIDF_WEIGHT=0.62
ENTITY_OVERLAP_WEIGHT=0.38
ENTITY_MIN_SCORE=0.016
ENTITY_MMR_LAMBDA=0.82
BOOTSTRAP_ENTITY_FROM_CHROMA=1

# Benchmark judge (GigaChat/OpenAI-compatible endpoint)
GIGACHAT_API_KEY=
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_VERIFY_SSL=1
GIGACHAT_TRUST_ENV=0

# PostgreSQL (analytics, tokens, admin)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/csu_faq

# Web app and admin
WEB_SECRET_KEY=change-me-dev-secret
WEB_ADMIN_USERNAME=kiproniks
ADMIN_WEB_PASSWORD=
ADMIN_DEFAULT_DAYS=14
PUBLIC_BASE_URL=
MINI_ADMIN_TTL_SEC=900
USER_MONTHLY_REQUEST_LIMIT=100

# Telegram admins (comma-separated chat ids)
ADMIN_TELEGRAM_IDS=


TELEGRAM_POLLING_BACKEND=auto
