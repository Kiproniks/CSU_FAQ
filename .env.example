TELEGRAM_BOT_TOKEN=

# LLM options: echo | ollama | openai
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SEC=120
OPENAI_API_KEY=

# Retrieval settings
CHROMA_PATH=./chroma_db
CHUNK_COLLECTION=harry_potter_collection
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K_CHUNKS=3
TOP_K_ENTITIES=3
BOOTSTRAP_ENTITY_FROM_CHROMA=1
